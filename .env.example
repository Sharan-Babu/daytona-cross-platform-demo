# Never commit a real key. Export these variables in your shell instead.
DAYTONA_API_KEY=dtn_replace_me
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Optional overrides used by the lifecycle scripts.
DAYTONA_WINDOWS_SNAPSHOT=windows-small
DAYTONA_SANDBOX_NAME=platform-pulse-windows-demo
DAYTONA_KEEP_SANDBOX=false
